{
  "name": "aurix-motors",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "npm run build:site && npm run build:admin && npm run build:assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:site": "vite build",
    "build:admin": "npm --prefix admin ci --no-audit --no-fund && npm --prefix admin run build",
    "build:assets": "rm -rf public_build && mkdir -p public_build && cp -R dist/. public_build/ && mkdir -p public_build/admin && cp -R admin/dist/. public_build/admin/",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@paper-design/shaders-react": "^0.0.76",
    "@tabler/icons-react": "^3.44.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.13.13",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "simple-icons": "^16.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@electric-sql/pglite": "^0.5.9",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8",
    "wrangler": "^4.149.0"
  }
}
